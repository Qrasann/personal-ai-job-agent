# Telegram control plane
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Multi-user onboarding (disabled by default; personal MVP is owner-first)
MULTI_USER_REGISTRATION=false
REGISTRATION_INVITE_CODE=

# HeadHunter discovery — applicant OAuth is NOT required for the base build.
# Use a real contact email in the User-Agent. HH may require CAPTCHA for anonymous
# API traffic; the agent will not bypass it.
HH_USER_AGENT=PersonalJobAgent/0.2 (your-email@example.com)
HH_SEARCH_PERIOD_DAYS=2
HH_PUBLIC_PER_PAGE=50
HH_PUBLIC_CACHE_MINUTES=60
HH_WEB_FALLBACK_ENABLED=true
HH_WEB_MAX_PAGES=1
HH_WEB_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:154.0) Gecko/20100101 Firefox/154.0

# Legacy/private HH applicant connector. Leave OFF for normal new installations.
HH_PRIVATE_API_ENABLED=false
HH_ACCESS_TOKEN=
HH_RESUME_ID=
HH_CHAT_INTERVAL_MINUTES=5

# General discovery cadence
SEARCH_INTERVAL_MINUTES=15

# LLM (optional for discovery/scoring; required for high-quality generated replies)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Automation safety
AUTO_APPLY=false
AUTO_REPLY=false
AUTO_APPLY_MIN_SCORE=92
AUTO_REPLY_MIN_CONFIDENCE=0.95

# Dedicated v3 DB
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@postgres:5432/jobagent_v3

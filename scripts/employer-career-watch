#!/usr/bin/env python3
"""Validate or read-only probe the curated official employer watchlist."""
from __future__ import annotations

import argparse
import asyncio
from dataclasses import asdict
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from app.sources.employer_watch import probe_watchlist
from app.sources.employer_watchlist import enabled_employers, load_employer_watchlist


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("validate", "probe"))
    args = parser.parse_args()
    watchlist = load_employer_watchlist()
    employers = enabled_employers()
    if args.command == "validate":
        openings = sum(len(item.openings) for item in employers)
        print(json.dumps({
            "verified_at": watchlist.verified_at.isoformat(),
            "employers": len(employers),
            "openings": openings,
            "network_requests": 0,
        }, sort_keys=True))
        return
    results = asyncio.run(probe_watchlist(employers))
    print(json.dumps([asdict(item) for item in results], indent=2, sort_keys=True))


if __name__ == "__main__":
    main()

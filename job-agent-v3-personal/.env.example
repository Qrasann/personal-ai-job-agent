# Telegram control plane
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Multi-user onboarding (disabled by default)
MULTI_USER_REGISTRATION=false
REGISTRATION_INVITE_CODE=

# HeadHunter owner account (MVP connector)
HH_ACCESS_TOKEN=
HH_RESUME_ID=
HH_USER_AGENT=PersonalJobAgent/0.1 (your-email@example.com)
HH_SEARCH_PERIOD_DAYS=2
HH_CHAT_INTERVAL_MINUTES=5

# General discovery cadence
SEARCH_INTERVAL_MINUTES=15

# LLM (optional for discovery/scoring)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Automation safety
AUTO_APPLY=false
AUTO_REPLY=false
AUTO_APPLY_MIN_SCORE=92
AUTO_REPLY_MIN_CONFIDENCE=0.95

# Dedicated v3 DB to avoid colliding with v2 schema
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@postgres:5432/jobagent_v3
